---
import type { Locale } from "@/i18n/locales";
import { t } from "@/i18n/t";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<form
  class="search"
  role="search"
  data-search
  data-unavailable={t(
    lang,
    // The build hint is for the author; readers get a plain message
    import.meta.env.DEV ? "search.devNotice" : "search.unavailable"
  )}
  data-lang={lang}
  data-no-results={t(lang, "search.noResults")}
>
  <label class="field">
    <span class="visually-hidden">{t(lang, "nav.search")}</span>
    <span class="sigil" aria-hidden="true">
      $
    </span>
    <input
      type="search"
      autocomplete="off"
      enterkeyhint="search"
      placeholder={t(lang, "search.placeholder")}
    />
  </label>
  <p class="status" data-search-status aria-live="polite"></p>
  <ol class="results" data-search-results></ol>
</form>

<script>
  import "@/scripts/search/box";
</script>

<style>
  .search {
    font-family: var(--font-mono);
    font-size: var(--text-chrome);
  }

  .field {
    display: flex;
    min-height: var(--tap-min);
    align-items: center;
    gap: 1ch;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border-input);
    border-radius: var(--radius);
  }

  .sigil {
    color: var(--color-accent);
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--color-text-primary);
    font: inherit;
    font-size: var(--text-base);
    outline: none;
  }

  .field:focus-within {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  .status {
    min-height: 1.5em;
    color: var(--color-text-muted);
  }

  .results {
    padding: 0;
    list-style: none;
  }

  .results :global(li) {
    margin-bottom: var(--space-4);
  }

  .results :global(.path) {
    color: var(--color-accent);
  }

  .results :global(.title) {
    color: var(--color-text-primary);
    font-weight: 700;
  }

  .results :global(.excerpt) {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-prose);
    overflow-wrap: anywhere;
  }

  .results :global(mark) {
    background: none;
    color: var(--color-text-highlight);
    font-weight: 700;
  }
</style>
