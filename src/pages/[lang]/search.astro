---
import { type Locale, localeStaticPaths } from "@/i18n/locales";
import { homeUrl, searchUrl } from "@/lib/navigation/routes";
import Base from "@/layouts/Base.astro";
import SearchBox from "@/components/SearchBox.astro";
import { t } from "@/i18n/t";

export const getStaticPaths = localeStaticPaths;

// The static paths above only produce locale params
const lang = Astro.params.lang as Locale;
---

<Base
  canonicalPath={searchUrl(lang)}
  context={{ kind: "search", lang }}
  lang={lang}
  prompt={{
    command: "grep -Fri",
    segments: [{ href: homeUrl(lang), label: lang }]
  }}
  statusLabel={`~/${lang}/search`}
  title={t(lang, "nav.search")}
>
  <SearchBox lang={lang} />
</Base>
