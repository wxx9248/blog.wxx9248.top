{
  // Static assets only: there is no "main", so Cloudflare never starts a Worker
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by `wrangler preview`, which builds each pull request's Preview
  "previews": {}
}
